# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys (and "Data API" for the URL).
#
# Both values are safe to be public: the database's security rules (RLS)
# decide what each signed-in user can see. NEVER put the "secret" or
# "service_role" key in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
